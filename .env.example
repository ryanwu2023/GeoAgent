# 必填：业务、翻译、配置、MCP 审计与采集账本共用 PostgreSQL（建议 17）。
GEO_DATABASE_URL=postgresql://geoagent:CHANGE_ME@127.0.0.1:5432/geoagent
# 可选：默认 public；测试使用独立 schema，禁止复用生产库。
# GEO_DATABASE_SCHEMA=public
# Set false for migration rehearsals; suppresses automatic translation on startup/import.
GEO_BACKGROUND_TASKS_ENABLED=true
# GEO_TEST_DATABASE_URL=postgresql://geoagent:CHANGE_ME@127.0.0.1:5432/geoagent_test
# 后台模型优先在页面「连接配置 → 后台模型（翻译/摘要）」填写、测试并保存。
# 页面配置热生效，保存在 GEO_DATA_DIR/model-settings.json（0600），包括“禁用”都优先于环境变量。
# 只有尚未保存页面配置时，后台模型才读取以下 .env / 进程环境变量；不与嵌入凭据混用。
# DeepSeek 页面配置：提供方 deepseek；地址 https://api.deepseek.com；
# 模型 deepseek-flash；超时90秒；填写自己的DeepSeek API Key，翻译请求关闭思考模式。
# 小样本测试与保存不启动批量翻译；现有启动/导入流程仍可能自动处理最新快照，注意额度。
# 其他环境变量仍按各自启动配置行为加载；不要把凭据写入 VITE_ 变量或提交 Git。
# 可选：默认读取项目内 data/collector-output
# CRAWLER_ROOT=D:/path/to/collector-output
# COLLECTOR_DATA_ROOT=D:/path/to/runtime-data
# KNOWLEDGE_ROOT=D:/path/to/research-materials
# 本地开发启动入口默认使用 Web 8010 + API 8011；如有端口冲突可整体覆盖。
# GEOAGENT_API_HOST=127.0.0.1
# GEOAGENT_API_PORT=8011
# GEOAGENT_WEB_HOST=127.0.0.1
# GEOAGENT_WEB_PORT=8010
# GEOAGENT_API_TARGET=http://127.0.0.1:8011
# 公网部署：精确的浏览器 Origin 白名单（逗号分隔），同时必须在入口配置认证。
# GEOAGENT_ALLOWED_ORIGINS=https://geoagentd40d.sealosgzg.site
# 推荐：接入 pi-chat-server。先在 Pi Chat 管理端创建绑定目标 Agent 的应用与
# API Key（需要 chat:invoke scope）；Key 只由本后端读取。
PICHAT_BASE_URL=http://127.0.0.1:9172
PICHAT_API_KEY=
PICHAT_TIMEOUT=90
# UI iframe embed（仅后端读取；不要写入 VITE_ 变量）：PiChat 管理端 GeoAgent API 应用的 pk- Key
PICHAT_EMBED_BASE_URL=http://127.0.0.1:9172
PICHAT_EMBED_APP_KEY=
PICHAT_EMBED_PHONE=
PICHAT_EMBED_PRODUCT_USER_ID=geoagent-local
PICHAT_EMBED_ENTRY=geoagent-research
# 页面「连接配置」保存后优先于上述嵌入环境变量，保存在 PostgreSQL。
# 连接配置与工作台不再使用额外管理口令；公网访问控制由部署层站点登录负责。
# 对外 /mcp 仍使用单独的 Bearer Key。
# 数据目录持久化原始附件、采集输出和模型配置；业务数据库单独备份。
# GEO_DATA_DIR=/data/geoagent
# Optional internal PiChat CA bundle (chain + hostname verification retained).
# GEOAGENT_PICHAT_CA_FILE=/absolute/path/to/ca-bundle.pem
# 旧环境变量兼容路径：有 PICHAT_API_KEY 时优先 PiChat，否则使用 LLM_*。
# 页面已保存任何 provider 后，不再隐式回退到这里的其他 Key。
# 支持兼容 Chat Completions 的基础 URL（一般包含 /v1），也支持完整 /chat/completions URL。
LLM_BASE_URL=https://api.openai.com/v1
# 可留空：尝试 GET /models，使用返回的首个非嵌入/语音/图像模型。
# 若服务没有 /models、首个模型不能对话，或希望指定模型，则填写服务商模型 ID。
LLM_MODEL=
LLM_FAST_MODEL=
LLM_REASONING_MODEL=
LLM_AGENT_MODE=tools
LLM_API_KEY=
# 欧洲天然气库存（https://agsi.gie.eu/ 免费注册后生成）
GIE_API_KEY=
# USDA PS&D（https://api.data.gov/signup/ 免费申请）
USDA_API_KEY=
LLM_TIMEOUT=90
# 非 PiChat 智能问答的模型循环轮数：初稿、复核补查、最终回答。范围 1-5，默认 3。
LLM_QA_ROUNDS=3
# 每轮导入后自动先用本地模型翻译，再用此模型补齐剩余语言。
# 0 表示处理全部剩余批次；可设置正整数限制单轮模型调用批次。
LLM_TRANSLATION_MAX_BATCHES=0

# 华泰宏观内部消息源。真实账号和密码只写入本地 .env，不得提交。
# 启用后服务启动即补采一轮，之后北京时间 08:00、14:00、20:00 抓取，令牌每27分钟刷新。
HT_MACRO_ENABLED=false
HT_MACRO_BASE_URL=http://172.16.52.33
HT_MACRO_REGION=+86
HT_MACRO_USERNAME=
HT_MACRO_PASSWORD=
HT_MACRO_CLIENT_CATEGORY=1
HT_MACRO_REFRESH_INTERVAL_SEC=1620
HT_MACRO_FETCH_TIMES=08:00,14:00,20:00
HT_MACRO_PAGE_SIZE=20
HT_MACRO_MAX_PAGES=100
HT_MACRO_TIMEOUT_SEC=30
QA_CONTEXT_MAX_TOKENS=32000
QA_CONTEXT_SOFT_TOKENS=24000
QA_CONTEXT_OUTPUT_RESERVE=6000
QA_TOOL_PREVIEW_TOKENS=1800

# Browser form login (production must enable and mount the existing SHA512-crypt htpasswd secret)
GEO_WEB_AUTH_ENABLED=false
GEO_WEB_AUTH_FILE=/etc/geoagent-auth/auth
GEO_WEB_AUTH_SECURE_COOKIE=true
